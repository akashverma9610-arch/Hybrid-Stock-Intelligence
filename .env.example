APP_ENV=development
APP_NAME=NSE Stock Manager
API_VERSION=v1
# List local frontend origins explicitly (for example add http://localhost:5173
# for a Vite / Google AI Studio-generated frontend). Wildcards are rejected.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_AUTOMATED_SELF_IMPROVEMENT_RESEARCH=false
# Runtime scheduling is opt-in only. FastAPI never starts it automatically;
# a future #028C host/CLI may explicitly invoke the one-cycle boundary.
RUNTIME_SCHEDULER_ENABLED=false
RUNTIME_CYCLE_INTERVAL_SECONDS=300
RUNTIME_MODE=STORED_DATA
# RUNTIME_UNIVERSE_ID=BROAD_5
# `worker` requires the explicit true setting above. There is no automatic
# FastAPI worker, no runtime control HTTP endpoint, and no provider fallback.
# U17 data operations are independently opt-in. FastAPI does not start this
# worker. It only dispatches approved, explicitly registered source adapters.
# Registered in Production V1: Upstox Historical Candle V3 for canonical NSE
# equity OHLCV and NIFTY 500/official sector-index bars, plus local official
# NSE delivery staging.  Upstox reads the existing secure `upstox` profile's
# `access_token`; never put that token in this file.  Delivery files are staged
# at data/incoming/delivery/ and archived/quarantined after validation.
DATA_OPERATIONS_ENABLED=false
DATA_OPERATIONS_POLL_SECONDS=300
# Internal forward-paper studies are research evidence only.  The worker is
# opt-in and requires an explicit stored setup/bar composition; it has no
# broker credentials, no FastAPI startup worker, and no live-order route.
PAPER_TRADING_ENABLED=false
PAPER_TRADING_POLL_SECONDS=300
# Project-owned file staging (never commit downloaded datasets):
# data/incoming/<family>/ -> validation/import -> data/archive/<family>/
# malformed input -> data/quarantine/<family>/
# Explicit ordered source responsibility per family; unset families remain
# unconfigured. These settings never contain credentials or trigger validation.
# DATA_SOURCE_CURRENT_QUOTES_PRIORITY=kotak_neo
# DATA_SOURCE_HISTORICAL_OHLCV_PRIORITY=stored_data
# DATA_SOURCE_FUNDAMENTALS_PRIORITY=future_fundamentals
# Provider selection is a typed boundary only in #027A. The only registered
# operational provider is deterministic local/test `mock`; no credentials are
# read and no live network connection is started from these settings.
MARKET_DATA_PROVIDER=mock
MARKET_DATA_PROVIDER_ENV=local
MARKET_DATA_TIMEOUT_SECONDS=10
MARKET_DATA_QUOTE_FRESHNESS_SECONDS=60
MARKET_DATA_INTRADAY_BAR_FRESHNESS_SECONDS=300
MARKET_DATA_DAILY_BAR_FRESHNESS_SECONDS=86400
# MARKET_DATA_CREDENTIAL_VARIABLE=FUTURE_PROVIDER_TOKEN
# Kotak Neo uses a TradeAPI Access Token for quote-only reads. An optional
# authenticated session uses a transient current authenticator code + MPIN. These names are
# placeholders only: never commit values or enable a production provider by
# accident. Quotes use the TradeAPI Access Token; an authenticated session additionally
# requires mobile/UCC/MPIN and receives a dynamic base URL. Do not store a TOTP seed.
# MARKET_DATA_PROVIDER=kotak_neo
# KOTAK_NEO_TRADEAPI_ACCESS_TOKEN=replace-with-kotak-neo-tradeapi-access-token
# KOTAK_NEO_MOBILE_NUMBER=replace-with-registered-mobile-number
# KOTAK_NEO_UCC=replace-with-kotak-neo-ucc
# KOTAK_NEO_MPIN=replace-with-mpin
# Optional isolated read-only smoke test; never enable by default.
# KOTAK_NEO_TEST_ENABLED=false
# KOTAK_NEO_TEST_EXCHANGE_SEGMENT=nse_cm
# KOTAK_NEO_TEST_INSTRUMENT_TOKEN=replace-with-test-token
# KOTAK_NEO_TEST_SYMBOL=RELIANCE
# SQLite is the default local/test backend. Explicit local runtime data commands
# use this persistent relative path; tests remain isolated with their own
# in-memory/temp databases. PostgreSQL is explicit and lazy.
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///data/nse_stock_manager.db
# The API reads persisted V1 core snapshots at lifespan startup; it has no
# snapshot-write endpoint or automatic live-data/runtime writer.
# PostgreSQL migrations include approved strategy versions and core API snapshots.
# Local/private development only. Do not expose this unauthenticated backend publicly.
# Use explicit CORS origins; wildcards are rejected.
HISTORICAL_DATA_PROVIDER=stored_data
# Optional provider-neutral historical source. Select exactly one explicit
# historical provider; the access token is stored through Settings/Connections,
# never committed here. V3 adjustment semantics remain unknown/partial.
# HISTORICAL_DATA_PROVIDER=upstox
# UPSTOX_TEST_INSTRUMENT_KEY=NSE_EQ%7C<official-isin>
# UPSTOX_TEST_SYMBOL=<safe-test-symbol>
# UPSTOX_LIVE_VALIDATION=false
# UPSTOX_ACCESS_TOKEN=<local-live-test-only-secret>
# Optional official NSE delivery acquisition. Disabled by default; when enabled,
# U17 invokes the local Node acquisition CLI for one explicitly selected session
# before the existing strict importer, archive, and quarantine boundary.
# NSE_DELIVERY_ACQUISITION_ENABLED=false
# NSE_DATA_BOT_NODE_EXECUTABLE=node
# NSE_DELIVERY_ACQUISITION_TIMEOUT_SECONDS=20
# Explicit bounded operator action after secure token setup:
# python -m app.runtime ingest-upstox-frozen-cohort --years 3
# Optional secondary, research-only Yahoo history. It has no credential and is
# never a source for fundamentals, ownership, delivery, filings, or corporate
# actions. Raw OHLC is explicitly requested; corporate-action integrity remains
# partial. It is limited to the existing frozen 40 cohort by CLI composition.
# HISTORICAL_DATA_PROVIDER=yfinance
# python -m app.runtime validate-yfinance-frozen-stock --years 3
# python -m app.runtime ingest-yfinance-frozen-cohort --years 3
# Optional: secure credential-store profile is preferred; never commit an access key.
# GDFL_LIVE_VALIDATION=false
# GDFL_TEST_EXCHANGE=NSE
# GDFL_TEST_INSTRUMENT=RELIANCE
# Optional secondary news/research evidence. Secret must be placed in the secure connection store,
# never committed here.  A live validation is explicit and disabled by default.
# DATA_SOURCE_NEWS_RESEARCH_PRIORITY=gnews
# GNEWS_LIVE_VALIDATION=false
# GNEWS_TEST_QUERY=Reliance Industries
